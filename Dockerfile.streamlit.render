# Streamlit UI for Render: trains the models during the build (same as Dockerfile.render),
# because trained models are not committed to the repository.

# Stage 1: train the models (runs src.pipeline, same as `make train`)
FROM python:3.12-slim AS trainer
WORKDIR /app
ENV MLFLOW_DISABLE_AGENT_HINT=1 MLFLOW_TRACKING_URI=sqlite:///mlflow.db GIT_PYTHON_REFRESH=quiet
# Build machines report the host's core count, so n_jobs=-1 / OpenMP would start far too many workers.
ENV LOKY_MAX_CPU_COUNT=2 OMP_NUM_THREADS=2
COPY requirements.txt requirements-serve.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY src/ src/
COPY data/ data/
COPY reports/ reports/
RUN mkdir -p models/metrics reports/figures && python -m src.pipeline

# Stage 2: UI image (same as Dockerfile.streamlit, with the freshly trained models)
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MLFLOW_DISABLE_AGENT_HINT=1 PORT=8501
WORKDIR /app
COPY requirements-serve.txt requirements-streamlit-image.txt ./
RUN pip install --no-cache-dir -r requirements-streamlit-image.txt
COPY src/ src/
COPY streamlit_app/ streamlit_app/
COPY data/ data/
COPY --from=trainer /app/models/ models/
COPY --from=trainer /app/reports/ reports/
RUN useradd --create-home --uid 1000 appuser && chown -R appuser /app
USER appuser
EXPOSE 8501
# Render sets PORT; shell form so it is expanded at start-up.
CMD streamlit run streamlit_app/app.py --server.port=$PORT --server.address=0.0.0.0 --server.headless=true
