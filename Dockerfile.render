# Stage 1: train the models (runs src.pipeline, same as `make train`)
FROM python:3.12-slim AS trainer
WORKDIR /app
ENV MLFLOW_DISABLE_AGENT_HINT=1 MLFLOW_TRACKING_URI=sqlite:///mlflow.db
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src/ src/
COPY data/ data/
RUN mkdir -p models/metrics reports/figures && python -m src.pipeline

# Stage 2: install serving dependencies only
FROM python:3.12-slim AS builder
WORKDIR /build
COPY requirements-serve.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements-serve.txt

# Stage 3: final API image (same as your Dockerfile)
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8000 MLFLOW_DISABLE_AGENT_HINT=1
WORKDIR /app
COPY --from=builder /install /usr/local
COPY src/ src/
COPY api/ api/
COPY --from=trainer /app/models/ models/
RUN useradd --create-home --uid 1000 appuser && chown -R appuser /app
USER appuser
EXPOSE 8000
CMD ["gunicorn", "-c", "api/gunicorn.conf.py", "api.app:app"]